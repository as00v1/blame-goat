{
  "name": "blamebox",
  "version": "1.2.7",
  "private": true,
  "description": "LOL背锅侠 —— 极地大乱斗赛后玩家角色判定（运行时零依赖）",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/server.mjs",
    "app": "node tools/build-desktop.mjs --dev",
    "icon": "node tools/make-icon.mjs",
    "check": "node tools/check-identifiers.mjs",
    "check:api": "node tools/check-api-guard.mjs",
